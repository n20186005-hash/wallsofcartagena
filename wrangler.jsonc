{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wallsofcartagena",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "upload_source_maps": false,
  "compatibility_date": "2026-08-27"
}
