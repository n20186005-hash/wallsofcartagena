---
import '../styles/global.css';

interface Props {
  lang: 'es' | 'en';
  htmlLang: string;
  siteName?: string;
  title: string;
  description: string;
  alternateHref: string;
  alternateLang: string;
  pagePath?: string;
  showConsent?: boolean;
}

const { lang, htmlLang, siteName = 'Cartagena Walls Visitor Guide', title, description, alternateHref, pagePath = Astro.url.pathname, showConsent = !['/privacidad/', '/terminos/', '/cookies/', '/en/privacy/', '/en/terms/', '/en/cookies/'].includes(Astro.url.pathname) } = Astro.props;
const canonical = Astro.site ? new URL(pagePath, Astro.site).href : pagePath;
const absUrl = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const xDefaultHref = absUrl(lang === 'es' ? pagePath : alternateHref);
const socialImage = Astro.site ? new URL('/photos/murallas-torre.jpg', Astro.site).href : undefined;
const ogLocale = lang === 'es' ? 'es_CO' : 'en_US';
const homeHref = lang === 'es' ? '/' : '/en/';
const cookieHref = lang === 'es' ? '/cookies/' : '/en/cookies/';
const privacyHref = lang === 'es' ? '/privacidad/' : '/en/privacy/';
const termsHref = lang === 'es' ? '/terminos/' : '/en/terms/';
const copy = lang === 'es'
  ? { consent: 'Privacidad', notice: 'Usamos preferencias locales y, con tu permiso, Google Analytics para mejorar esta guía.', accept: 'Aceptar analíticas', decline: 'Solo necesarias', configure: 'Ver configuración' }
  : { consent: 'Privacy', notice: 'We use local preferences and, with your permission, Google Analytics to improve this guide.', accept: 'Accept analytics', decline: 'Necessary only', configure: 'View settings' };
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#073b4c" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'es' ? 'es-CO' : 'en'} href={absUrl(pagePath)} />
    <link rel="alternate" hreflang={lang === 'es' ? 'en' : 'es-CO'} href={absUrl(alternateHref)} />
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/photos/murallas-torre.jpg" as="image" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    {Astro.site && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={lang === 'es' ? 'Murallas de Cartagena - Vista principal en Cartagena de Indias, Colombia' : 'Walls of Cartagena - Main view in Cartagena de Indias, Colombia'} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <slot />
    <footer class="site-footer">
      <div class="footer-grid shell">
        <a class="footer-brand" href={homeHref} aria-label={lang === 'es' ? 'Inicio de Guía de las Murallas de Cartagena' : 'Cartagena Walls Guide home'}>
          <img src="/mark.svg" width="40" height="40" alt="" />
          <span>{lang === 'es' ? 'Murallas de Cartagena' : 'Cartagena Walls'}</span>
        </a>
        <div class="footer-links" aria-label={lang === 'es' ? 'Información legal' : 'Legal information'}>
          <a href={privacyHref}>{lang === 'es' ? 'Privacidad' : 'Privacy'}</a>
          <a href={termsHref}>{lang === 'es' ? 'Términos' : 'Terms'}</a>
          <a href={cookieHref}>{lang === 'es' ? 'Cookies' : 'Cookies'}</a>
        </div>
        <p class="footer-provenance">{lang === 'es' ? 'Fuentes públicas contrastadas: UNESCO y Fortificaciones Cartagena de Indias.' : 'Public sources checked: UNESCO and Fortificaciones Cartagena de Indias.'}</p>
      </div>
      <div class="footer-rule shell"></div>
      <div class="footer-bottom shell">
        <p>{lang === 'es' ? 'Guía independiente de visitantes. No es un sitio oficial.' : 'Independent visitor guide. Not an official website.'}</p>
        <p>{lang === 'es' ? '© 2026 Guía de las Murallas de Cartagena' : '© 2026 Cartagena Walls Guide'}</p>
      </div>
    </footer>
    {showConsent && <>
    <aside class="consent-banner" data-consent-banner aria-label={copy.consent} hidden>
      <div>
        <p class="consent-title">{copy.consent}</p>
        <p>{copy.notice}</p>
      </div>
      <div class="consent-actions">
        <a class="text-action" href={cookieHref}>{copy.configure}</a>
        <button class="button button-quiet" data-consent="necessary">{copy.decline}</button>
        <button class="button" data-consent="analytics">{copy.accept}</button>
      </div>
    </aside>
    </>}
    <script is:inline src="/analytics.js"></script>
    <script is:inline>
      const banner = document.querySelector('[data-consent-banner]');
      let hasChoice = false;
      try { hasChoice = ['analytics', 'necessary'].includes(localStorage.getItem('murallas-cookie-consent')); } catch {}
      if (banner) banner.hidden = hasChoice;
      document.querySelectorAll('[data-consent]').forEach(button => button.addEventListener('click', () => {
        const result = window.wallsAnalytics.set(button.dataset.consent === 'analytics');
        if (banner) banner.hidden = result.saved;
        let status = document.querySelector('[data-consent-status]');
        if (!status && banner) { status = document.createElement('p'); status.dataset.consentStatus = ''; status.setAttribute('role', 'status'); banner.appendChild(status); }
        if (status) status.textContent = result.saved ? '' : (document.documentElement.lang.startsWith('es') ? 'No se pudo guardar. Analytics está desactivado aquí. Revisa Configuración de cookies.' : 'Could not save. Analytics is off here. Check Cookie settings.');
      }));
    </script>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
