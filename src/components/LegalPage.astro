---
import type { Locale } from '../data/site-data';

interface Props {
  lang: Locale;
  kind: 'privacy' | 'terms' | 'cookies';
  title: string;
  lead: string;
  sections: { title: string; paragraphs: string[] }[];
}

const { lang, kind, title, lead, sections } = Astro.props;
const homeHref = lang === 'es' ? '/' : '/en/';
const cookieCopy = lang === 'es'
  ? { essential: 'Necesarias', analytics: 'Google Analytics', description: 'La medición solo se carga cuando eliges esta opción.', save: 'Guardar preferencias', saved: 'Preferencias guardadas.' }
  : { essential: 'Necessary', analytics: 'Google Analytics', description: 'Measurement loads only when you choose this option.', save: 'Save preferences', saved: 'Preferences saved.' };
---

<main class="legal-page" id="contenido">
  <header class="legal-header shell">
    <a class="brand legal-brand" href={homeHref} aria-label={lang === 'es' ? 'Inicio de la Guía de las Murallas de Cartagena' : 'Cartagena Walls Guide home'}>
      <img src="/mark.svg" width="42" height="42" alt="" />
      <span><span class="text-emphasis">{lang === 'es' ? 'Murallas' : 'Cartagena'}</span><small>{lang === 'es' ? 'Cartagena de Indias' : 'Walls guide'}</small></span>
    </a>
    <a class="back-link" href={homeHref}>← {lang === 'es' ? 'Volver a la guía' : 'Back to the guide'}</a>
  </header>
  <section class="legal-hero">
    <div class="shell">
      <p class="eyebrow">{lang === 'es' ? 'Información del sitio' : 'Website information'}</p>
      <h1>{title}</h1>
      <p>{lead}</p>
      <p class="last-updated">{lang === 'es' ? 'Última actualización: 22 de octubre de 2026' : 'Last updated: 22 October 2026'}</p>
    </div>
  </section>
  <article class="legal-content shell">
    {sections.map((section) => (
      <section>
        <h2>{section.title}</h2>
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </section>
    ))}
    {(kind === 'privacy' || kind === 'cookies') && (
      <section>
        <h2>Cloudflare Web Analytics (RUM)</h2>
        <p>{lang === 'es'
          ? 'El alojamiento incorpora un beacon de rendimiento de Cloudflare, separado de Google Analytics. La elección analítica de esta guía controla su integración de Google Analytics, no el beacon del alojamiento. La presencia del script no confirma que se hayan enviado métricas durante una visita concreta.'
          : 'The hosting service includes a Cloudflare performance beacon, separate from Google Analytics. This guide’s analytics choice controls its Google Analytics integration, not the hosting beacon. The presence of the script does not confirm that metrics were sent during a particular visit.'}</p>
        <p><a href="https://developers.cloudflare.com/web-analytics/data-metrics/data-origin-and-collection/">{lang === 'es' ? 'Documentación de Cloudflare sobre la recopilación de datos' : 'Cloudflare documentation on data collection'}</a></p>
      </section>
    )}
    {kind === 'cookies' && (
      <section class="preference-panel" aria-labelledby="preference-title">
        <h2 id="preference-title">{lang === 'es' ? 'Tus preferencias' : 'Your preferences'}</h2>
        <form data-preference-form>
          <label class="preference-option">
            <span><span class="text-emphasis">{cookieCopy.essential}</span><small>{lang === 'es' ? 'Almacenamiento local, si el navegador lo permite.' : 'Local storage, if the browser permits it.'}</small></span>
            <input type="checkbox" checked disabled aria-label={cookieCopy.essential} />
          </label>
          <label class="preference-option">
            <span><span class="text-emphasis">{cookieCopy.analytics}</span><small>{cookieCopy.description}</small></span>
            <input type="checkbox" data-analytics-toggle aria-label={cookieCopy.analytics} />
          </label>
          <button class="button" type="submit">{cookieCopy.save}</button>
          <p class="preference-status" data-preference-status role="status" aria-live="polite"></p>
        </form>
      </section>
    )}
  </article>
</main>

{kind === 'cookies' && <script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    const toggle = document.querySelector('[data-analytics-toggle]');
    const form = document.querySelector('[data-preference-form]');
    const status = document.querySelector('[data-preference-status]');
    const es = document.documentElement.lang.startsWith('es');
    toggle.checked = window.wallsAnalytics.get();
    form.addEventListener('submit', event => {
      event.preventDefault();
      const result = window.wallsAnalytics.set(toggle.checked);
      toggle.checked = result.effective;
      status.textContent = result.saved
        ? (es ? 'Preferencia guardada. Analytics ' + (result.effective ? 'activado.' : 'desactivado.') : 'Preference saved. Analytics ' + (result.effective ? 'enabled.' : 'disabled.'))
        : (es ? 'No se pudo guardar la opción. Analytics está desactivado en esta página. ' : 'The choice could not be saved. Analytics is off on this page. ') + (result.sharedOff
          ? (es ? 'Se confirmó que no queda permiso guardado; puedes volver a intentarlo.' : 'No saved permission remains; you can try again.')
          : (es ? 'Puede quedar permiso guardado, incluso de este intento, utilizable en otras pestañas o al recargar.' : 'Saved permission may remain, including from this attempt, usable in other tabs or after reload.'));
    });
  });
</script>}
