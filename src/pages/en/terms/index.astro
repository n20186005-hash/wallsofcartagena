---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LegalPage from '../../../components/LegalPage.astro';
import { content, legalContent } from '../../../data/site-data';

const page = content.en;
const legal = legalContent.en.terms;
---

<BaseLayout lang="en" htmlLang="en" title={`${legal.title} | ${page.siteName}`} description={legal.lead} alternateHref="/terminos/" alternateLang="es-CO">
  <LegalPage lang="en" kind="terms" {...legal} />
</BaseLayout>
